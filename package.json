{
  "name": "chatlayer",
  "version": "0.5.1",
  "private": true,
  "description": "Power-user enhancement layer for AI chat interfaces.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "chrome-extension",
    "mermaid",
    "plantuml",
    "chatgpt",
    "gemini"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "mermaid": "^11.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.42",
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
