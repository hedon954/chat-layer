{
  "manifest_version": 3,
  "name": "ChatLayer",
  "version": "0.3.2",
  "description": "Add outlines, diagrams, and workflow tools to AI chatbots.",
  "icons": {
    "16": "icons/chatlayer-16.png",
    "32": "icons/chatlayer-32.png",
    "48": "icons/chatlayer-48.png",
    "128": "icons/chatlayer-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/chatlayer-16.png",
      "32": "icons/chatlayer-32.png",
      "48": "icons/chatlayer-48.png",
      "128": "icons/chatlayer-128.png"
    },
    "default_title": "ChatLayer"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://www.plantuml.com/*",
    "http://www.plantuml.com/*",
    "https://plantuml.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["content-loader.js"],
      "css": ["assets/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options/index.html",
  "web_accessible_resources": [
    {
      "resources": [
        "sandbox/mermaid.html",
        "assets/*.js",
        "assets/sandbox.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ]
    }
  ],
  "sandbox": {
    "pages": ["sandbox/mermaid.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; object-src 'none';"
  }
}
